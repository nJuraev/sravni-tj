APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Telegram-бот (подписка на уведомления о курсе + меню) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Ссылка на канал для мягкого инвайта (2-е сообщение бота). Пусто → не шлётся.
TELEGRAM_CHANNEL_INVITE_LINK=
# chat_id канала для ежедневных финансовых постов (posts:generate-daily).
TELEGRAM_CHANNEL_ID=
# Секрет webhook: тот же, что secret_token в setWebhook (сверяется с
# X-Telegram-Bot-Api-Secret-Token).
TELEGRAM_WEBHOOK_SECRET=
# Секрет internal-эндпоинта rates-notify. ДОЛЖЕН совпадать с
# BACKEND_RATES_WEBHOOK_SECRET у Go-парсера (корневой .env).
TELEGRAM_RATES_WEBHOOK_SECRET=
# База для ссылок бота (профиль/курсы/каталог). Прод — публичный домен фронта.
FRONTEND_URL=https://sravni.tj

# --- AI (генерация текста ежедневных постов, posts:run-scheduler) ---
# Те же имена, что у Go-парсера (parser/.env) — можно указать тот же ключ.
AI_PROVIDER=openrouter
AI_API_KEY=
AI_MODEL=
