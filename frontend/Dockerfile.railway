# Прод-образ фронта для Railway: SSR-рендер (Vite build:client + build:server)
# отдаётся живым Node/Express-процессом, не статик-сервером.
# (Локальная разработка использует ./Dockerfile + docker-compose, этот файл — только Railway.)

# --- Сборка ---
FROM node:22-alpine AS build
WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

# VITE_* вшиваются в бандл НА ЭТАПЕ СБОРКИ — и в клиентский, и в серверный
# (оба видят один и тот же import.meta.env). Railway прокидывает переменные
# сервиса как build args — объявляем их через ARG и кладём в ENV до build.
ARG VITE_API_BASE_URL
ARG VITE_USE_MOCKS=false
ARG VITE_PUBLIC_SITE_ORIGIN=https://sravni.tj
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_USE_MOCKS=$VITE_USE_MOCKS
ENV VITE_PUBLIC_SITE_ORIGIN=$VITE_PUBLIC_SITE_ORIGIN
RUN npm run build

# --- Рантайм: живой SSR-процесс (Express + vue/server-renderer) ---
FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production

# Рантайм-зависимости (vue, vue-router, pinia, vue-i18n, @unhead/vue, express)
# реально нужны здесь — Vite не инлайнит их в SSR-бандл, они резолвятся из
# node_modules в момент запуска. --omit=dev убирает vite/vue-tsc/vitest и т.п.
COPY package*.json ./
RUN npm ci --omit=dev

COPY --from=build /app/dist ./dist
COPY --from=build /app/server ./server

EXPOSE 8080
# server/index.js сам читает $PORT (Railway) через process.env — shell-обёртка
# ${PORT:-8080} из старой static-serve версии больше не нужна.
CMD ["node", "server/index.js"]
